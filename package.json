{
  "name": "kuaiblog",
  "version": "1.0.0",
  "description": "A zero-build-step Docsify Markdown blog engine with Geek Dark & Pastel Light themes, IDE-grade syntax highlighting, MathJax, Mermaid 12, APlayer/DPlayer tags, and automatic search cache invalidation.",
  "main": "lib/index.js",
  "bin": {
    "kuaiblog": "./bin/kuaiblog.js"
  },
  "scripts": {
    "test": "node bin/kuaiblog.js --help"
  },
  "files": [
    "bin/",
    "lib/",
    "template/",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "blog",
    "docsify",
    "markdown",
    "static-site-generator",
    "kuaiblog",
    "mermaid",
    "mathjax",
    "aplayer",
    "dplayer"
  ],
  "author": "TuKuai (GallantTarry)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GallantTarry/kuaiblog.git"
  },
  "bugs": {
    "url": "https://github.com/GallantTarry/kuaiblog/issues"
  },
  "homepage": "https://github.com/GallantTarry/kuaiblog#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
